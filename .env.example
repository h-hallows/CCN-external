# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded PGlite database at .pglite/ — no server
# required, and what `npm test` runs against out of the box.
#
# PGlite keeps its database in one directory and one process owns it at a time, so stop
# the dev server before reseeding, then start it again.
#
# The marketing pages do not need a database at all and serve without one. Everything
# behind a sign-in does: /login, /portal, /pro, /partner, /invite/[token] and every
# route under /api. With no database a production build serves those as an explicit
# "unavailable" page rather than an error — `/api/health` says which state it is in.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# DATABASE_URL is the POOLED connection the running app uses. Include ?sslmode=require.
#
# There is no DIRECT_URL here on purpose. The unpooled connection exists for migrations,
# which contain CREATE TYPE, CREATE FUNCTION and CREATE TRIGGER statements that a pooler
# in transaction mode cannot execute — and migrations are applied from the console
# repository (CCN-Registry, `npm run db:deploy`), never from this one. Both applications
# read the same single database; this one only ever reads and writes rows.

# ---------------------------------------------------------------------------
# Mail — and why nobody can sign in without it
# ---------------------------------------------------------------------------
# In development a sign-in link is printed to the server console, because there is
# nowhere else for it to go.
#
# ON A DEPLOYMENT IT IS NOT, AND NOTHING IN THIS FILE CHANGES THAT. A sign-in link is a
# bearer credential with a short life, and a log is not a place to put one: function logs
# are read by platform collaborators, log drains and aggregators with retention windows
# nobody is watching.
# So the console driver resolves to 'none' whenever NODE_ENV is production, and
# MAIL_DRIVER=console does not override it. The sign-in form decides whether a mailer is
# configured BEFORE it looks an address up — a configuration failure is the same for
# every address, while a delivery failure is not, and branching after the lookup would
# turn the form into a way to find out which families use us.
#
# The consequence: with no mail provider configured, no household, nurse or referral
# partner can sign in at all. Set both of these. Resend refuses a domain it has not
# verified, so MAIL_FROM is as necessary as the key.
RESEND_API_KEY=
MAIL_FROM=

# Optional. Where a reply goes when somebody answers a sign-in or notification mail.
MAIL_REPLY_TO=

# Optional, and normally left alone: 'resend' or 'console'. Unset means resend when a key
# is present and console otherwise. Any other value resolves to 'none', which sends
# nothing — the sign-in page then says so by name rather than failing silently.
MAIL_DRIVER=

# Where "something arrived" is sent when an enquiry, a referral or an application lands.
# The message carries the subject and a sentence and nothing else: no name, no address,
# no clinical detail. That belongs in the console, not in an inbox.
OPERATOR_NOTIFY_EMAIL=

# Read by the shared seed to decide which address the seeded operator account uses. This
# application has no operator surface — its /login refuses the operator role outright —
# so on a deployment of this site it changes nothing.
OPERATOR_EMAILS=operator@example.com

# ---------------------------------------------------------------------------
# Where this site thinks it lives
# ---------------------------------------------------------------------------
# The canonical origin, used by the sitemap, robots.txt, canonical links and the social
# card. Unset, a Vercel deployment falls back to the host's own production URL and a
# local build to http://localhost:3003 — so a build never emits `undefined/sitemap.xml`,
# but it will also happily publish a sitemap pointing at the wrong hostname. Set it.
#
# This is also the address the operator console sends people to when it grants portal
# access, and the console reads it under the same name (or PORTAL_URL) in its own
# environment, not from this one.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# The name — Civ. Code § 1812.533(b)(2), Health & Safety Code § 1726(b)
# ---------------------------------------------------------------------------
# EVERY NEXT_PUBLIC_* VALUE BELOW IS INLINED AT BUILD TIME. Changing one in a hosting
# dashboard does nothing to a deployment that was already built: redeploy after saving,
# or the site goes on serving the value it was compiled with.
#
# The registry's name as it is actually filed. Unset, the site serves under "CCN" and is
# never indexed, which is the safe state rather than an accident.
NEXT_PUBLIC_LEGAL_NAME=

# Set to 1 only once the name above is the filed one rather than a stand-in. Two
# different questions were once answered by one variable: "is a name configured", which
# decides whether a page can render, and "is that name the filed one", which decides
# whether the page may be advertised. A site put up to be looked at became a site search
# engines would index under a name nobody had filed. Nothing infers this — it is one more
# variable, set deliberately, the day counsel clears the name.
NEXT_PUBLIC_NAME_IS_FILED=

# A marketing name, only once counsel confirms a DBA is acceptable. Defaults to the
# filed name above.
NEXT_PUBLIC_DISPLAY_NAME=

# § 1812.533(b)(2) wants the correct name plus one of these in every advertisement. Set
# at least one. Unset, the pages say "Telephone pending" rather than printing a number
# somebody could dial — a fake telephone number on a page is worse than no number.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_STREET=

# The person a partner referral is acknowledged by. A discharge planner who sends a
# family somewhere wants to know who picked it up. Unset, the acknowledgement omits the
# name rather than printing a placeholder.
NEXT_PUBLIC_OPERATOR_NAME=

# ---------------------------------------------------------------------------
# The posted fee schedule — § 1812.527, § 1812.530
# ---------------------------------------------------------------------------
# /pricing posts what a household is charged, which § 1812.527 expects a registry to
# post, and states § 1812.530's rule that a nurse is never charged. These two figures
# are the two columns of the schedule a household asks about, and only the operator can
# supply them — from the schedule actually posted in the console, not from an estimate.
# Unset, the page marks each as a placeholder and says who owes it, which is true;
# a plausible invented number would not be.
NEXT_PUBLIC_FEE_PCT=
NEXT_PUBLIC_FEE_TERMS=

# ---------------------------------------------------------------------------
# The privacy notice
# ---------------------------------------------------------------------------
# /privacy is grounded in what this code actually does — read out of the intake schemas,
# the three API routes, the rate limiter, the mailer and the portal database. These five
# are the commitments the code cannot make on the business's behalf. Unset, each prints
# as a marked placeholder naming who owes it. That is the deliberate behaviour: the page
# says what is true instead of claiming a right nobody has granted.
#
# How long an enquiry, a referral or an application is kept, and what happens to it then.
NEXT_PUBLIC_PRIVACY_RETENTION=

# Where a person sends a request to see, correct or remove what is held about them.
NEXT_PUBLIC_PRIVACY_REQUESTS=

# Who answers a question about the notice, and how to reach them.
NEXT_PUBLIC_PRIVACY_CONTACT=

# What the business says about selling or sharing personal information, and how to opt
# out if it does. This is the one commitment where silence reads as an answer: nothing
# in this application sends what a form collects anywhere but the database and the
# operator's own console, and the page says exactly that — but whether the BUSINESS sells
# or shares is a statement about the business, not about the software. Civ. Code
# § 1798.100 and following wants it said plainly.
NEXT_PUBLIC_PRIVACY_SALE=

# The companies that hold or carry this information on our behalf, named — from the
# deployment as it actually stands, not from an intention.
NEXT_PUBLIC_PRIVACY_PROCESSORS=
